---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
}

const { title = `${site.name} | ${site.brand}`, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>

	<script>
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					io.unobserve(entry.target);
				}
			},
			{ threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
		);
		document.querySelectorAll('.js-reveal').forEach((el) => io.observe(el));
	</script>
</html>
