---
// 旧デザイン（Bootstrap 版）ページ用のレイアウト。
//
// 【重要】このレイアウトは Tailwind を読み込まない。
// 新デザイン側の Layout.astro が読む global.css（Tailwind）を混ぜると、
// Tailwind のリセットが Bootstrap の見た目を壊すため、意図的に分離している。
// 新デザインのページは Layout.astro を使うこと。
//
// 外部スクリプトはすべて is:inline を付けて、記述順と内容をそのまま維持する
// （jQuery より後に $ を使うスクリプトが来る順序に依存しているため）。
import OldHeader from '../components/old/OldHeader.astro';
import OldFooter from '../components/old/OldFooter.astro';
import { oldSiteMeta } from '../data/oldSite';

interface Props {
	title?: string;
	description?: string;
	/** OGP の og:url。省略時はサイトのトップ。 */
	ogUrl?: string;
	/** フッタを出すか。元サイトではトップページのみフッタを持っていた。 */
	showFooter?: boolean;
}

const {
	title = oldSiteMeta.title,
	description = oldSiteMeta.description,
	ogUrl = oldSiteMeta.siteUrl,
	showFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# website: http://ogp.me/ns/website#">
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<title>{title}</title>

		<meta name="description" content={description} />
		<meta name="keywords" content={oldSiteMeta.keywords} />
		<link rel="icon" type="image/png" href="/images/fav.png" />

		<!-- OGP -->
		<meta property="og:url" content={ogUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={oldSiteMeta.title} />
		<meta property="og:image" content={oldSiteMeta.ogImage} />

		<!--
			代替フォント（Noto Serif JP）。
			本来のフォントは TypeSquare（さくらぎ蛍雪）と Adobe Fonts（FOT-クレー Pro）だが、
			いずれも契約ドメインでしか配信されないため、localhost や *.netlify.app では
			表示されない。その場合に既定のゴシック体へ落ちないよう、
			style.css の font-family に "Noto Serif JP" を代替として入れてある。
		-->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600&display=swap"
		/>

		<!-- css -->
		<link rel="stylesheet" href="/css/style.css" />

		<!-- フォント さくらぎ蛍雪（TypeSquare / モリサワ） -->
		<script
			is:inline
			type="text/javascript"
			src="//typesquare.com/3/tsst/script/ja/typesquare.js?6145f51534984337b6910c91ac1e02e5"
			charset="utf-8"></script>

		<!-- FOT-クレー Pro（Adobe Fonts） -->
		<script is:inline>
			(function (d) {
				var config = {
						kitId: 'dzp2fow',
						scriptTimeout: 3000,
						async: true,
					},
					h = d.documentElement,
					t = setTimeout(function () {
						h.className = h.className.replace(/\bwf-loading\b/g, '') + ' wf-inactive';
					}, config.scriptTimeout),
					tk = d.createElement('script'),
					f = false,
					s = d.getElementsByTagName('script')[0],
					a;
				h.className += ' wf-loading';
				tk.src = 'https://use.typekit.net/' + config.kitId + '.js';
				tk.async = true;
				tk.onload = tk.onreadystatechange = function () {
					a = this.readyState;
					if (f || (a && a != 'complete' && a != 'loaded')) return;
					f = true;
					clearTimeout(t);
					try {
						Typekit.load(config);
					} catch (e) {}
				};
				s.parentNode.insertBefore(tk, s);
			})(document);
		</script>

		<!-- jQuery -->
		<script is:inline src="https://code.jquery.com/jquery-3.5.1.min.js"></script>

		<!-- Bootstrap -->
		<link
			rel="stylesheet"
			href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css"
			integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk"
			crossorigin="anonymous"
		/>
		<script
			is:inline
			src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"
			integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo"
			crossorigin="anonymous"></script>
		<script
			is:inline
			src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js"
			integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI"
			crossorigin="anonymous"></script>

		<!-- スライドショー（Swiper） -->
		<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />

		<!-- Google Analytics -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=UA-211583920-1"
		></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'UA-211583920-1');
		</script>
	</head>

	<body>
		<OldHeader />

		<slot />

		{showFooter && <OldFooter />}

		<!-- ページ固有のスクリプト -->
		<slot name="scripts" />
	</body>
</html>
