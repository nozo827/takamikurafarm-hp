---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { newsFallback, site } from '../../data/site';
import { getNews } from '../../lib/microcms';
import type { NewsItem } from '../../lib/microcms';

export async function getStaticPaths() {
	const fetchedNews = await getNews(50);
	const items: NewsItem[] = fetchedNews.length > 0 ? fetchedNews : newsFallback;

	return items.map((item) => ({
		params: { id: item.id },
		props: { item },
	}));
}

interface Props {
	item: NewsItem;
}

const { item } = Astro.props;

function formatDate(dateStr: string) {
	const d = new Date(dateStr);
	return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
}
---

<Layout title={`${item.title} | ${site.name}`}>
	<Header />
	<main class="bg-cream pb-24 pt-[calc(var(--header-height,7rem)+1rem)] sm:pb-32 sm:pt-[calc(var(--header-height,9rem)+1.5rem)]">
		<div class="mx-auto max-w-2xl px-6 sm:px-8">
			<a
				href="/news.html"
				class="js-reveal inline-flex items-center gap-2 text-xs tracking-wide text-ink/50 transition-colors hover:text-gold"
			>
				← お知らせ一覧へ戻る
			</a>

			<article class="js-reveal mt-8">
				<time class="text-xs tracking-wide text-ink/50">{formatDate(item.publishedAt)}</time>
				<h1 class="mt-2 font-serif text-xl leading-relaxed text-soil sm:text-2xl">
					{item.title}
				</h1>
				<div class="mt-6 h-px w-16 bg-gold"></div>

				{item.image && (
					<img
						src={item.image.url}
						alt=""
						class="mt-8 aspect-video w-full rounded-sm object-cover"
					/>
				)}

				{item.content && (
					<p class="mt-8 whitespace-pre-line text-sm leading-8 text-ink/80 sm:text-base sm:leading-9">
						{item.content}
					</p>
				)}
			</article>
		</div>
	</main>
	<Footer />
</Layout>
