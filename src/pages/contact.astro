---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contact, site } from '../data/site';
---

<Layout title={`お問い合わせ | ${site.name}`}>
	<Header />
	<main class="bg-cream pb-24 pt-[calc(var(--header-height,7rem)+1rem)] sm:pb-32 sm:pt-[calc(var(--header-height,9rem)+1.5rem)]">
		<div class="mx-auto max-w-4xl px-6 sm:px-8">
			<div class="js-reveal text-center">
				<p class="text-xs tracking-[0.35em] text-moss">CONTACT</p>
				<h1 class="mt-3 font-serif text-2xl text-soil sm:text-3xl">お問い合わせ</h1>
				<div class="mx-auto mt-4 h-px w-16 bg-gold"></div>
				<p class="mx-auto mt-5 max-w-xl text-sm leading-8 text-ink/80 sm:text-base sm:leading-9">
					{contact.note}
				</p>
			</div>

			<div class="mt-10 grid gap-12 lg:grid-cols-2 lg:gap-16">
				<!--
					送信先は formrun。旧サイト(contact.html)で実際に運用されていた
					エンドポイントをそのまま引き継いでいる。
					項目名(name)は formrun 側の設定と一致させる必要があるため、
					日本語のまま変更しないこと。
				-->
				<form
					id="contact-form"
					action="https://form.run/api/v1/r/gxpti6wern8c34itsi643d5h"
					method="post"
					class="js-reveal order-1 flex flex-col gap-6 lg:order-2"
				>
					<p class="text-xs tracking-[0.3em] text-moss">お問い合わせフォーム</p>

					<div>
						<label for="name" class="text-sm text-soil">
							お名前 <span class="text-gold">*</span>
						</label>
						<input
							id="name"
							name="お名前"
							type="text"
							required
							class="mt-2 w-full rounded-sm border border-soil/20 bg-white px-4 py-3 text-sm text-ink outline-none transition-colors focus:border-gold"
						/>
					</div>

					<div>
						<label for="organization" class="text-sm text-soil">所属</label>
						<input
							id="organization"
							name="所属"
							type="text"
							class="mt-2 w-full rounded-sm border border-soil/20 bg-white px-4 py-3 text-sm text-ink outline-none transition-colors focus:border-gold"
						/>
					</div>

					<div>
						<label for="email" class="text-sm text-soil">
							メールアドレス <span class="text-gold">*</span>
						</label>
						<input
							id="email"
							name="メールアドレス"
							type="email"
							required
							class="mt-2 w-full rounded-sm border border-soil/20 bg-white px-4 py-3 text-sm text-ink outline-none transition-colors focus:border-gold"
						/>
					</div>

					<div>
						<label for="message" class="text-sm text-soil">
							お問い合わせ内容 <span class="text-gold">*</span>
						</label>
						<textarea
							id="message"
							name="お問い合わせ"
							rows="6"
							required
							class="mt-2 w-full rounded-sm border border-soil/20 bg-white px-4 py-3 text-sm text-ink outline-none transition-colors focus:border-gold"
						></textarea>
					</div>

					<!-- ボット投稿をブロックするための項目（利用者には見えない） -->
					<div class="absolute h-px w-px overflow-hidden" aria-hidden="true">
						<label for="_formrun_gotcha">If you are a human, ignore this field</label>
						<input type="text" name="_formrun_gotcha" id="_formrun_gotcha" tabindex="-1" />
					</div>

					<button
						type="submit"
						class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-gold px-8 py-3 text-sm font-medium tracking-wide text-cream shadow-md transition-colors hover:bg-gold-light"
					>
						送信する
					</button>
					<p class="text-xs leading-6 text-ink/50">
						送信いただいた内容は、担当者が確認のうえご返信いたします。お急ぎの場合はお電話でもご連絡いただけます。
					</p>
				</form>

				<div class="js-reveal order-2 lg:order-1">
					<p class="font-serif text-lg text-soil">{contact.companyName}</p>
					<dl class="mt-6 space-y-5 text-sm leading-7 text-ink/80">
						<div>
							<dt class="text-xs tracking-widest text-moss">住所</dt>
							<dd class="mt-1">
								〒{contact.postalCode}<br />
								{contact.address}
							</dd>
						</div>
						<div>
							<dt class="text-xs tracking-widest text-moss">TEL</dt>
							<dd class="mt-1">
								<a href={`tel:${contact.tel.replace(/-/g, '')}`} class="transition-colors hover:text-gold">
									{contact.tel}
								</a>
							</dd>
						</div>
						<div>
							<dt class="text-xs tracking-widest text-moss">FAX</dt>
							<dd class="mt-1">{contact.fax}</dd>
						</div>
						<div>
							<dt class="text-xs tracking-widest text-moss">Mail</dt>
							<dd class="mt-1">
								<a href={`mailto:${contact.email}`} class="transition-colors hover:text-gold">
									{contact.email}
								</a>
							</dd>
						</div>
					</dl>
				</div>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
