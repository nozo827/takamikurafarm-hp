---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsList from '../components/NewsList.astro';
import { newsFallback, site } from '../data/site';
import { getNews } from '../lib/microcms';

const fetchedNews = await getNews(50);
const items = fetchedNews.length > 0 ? fetchedNews : newsFallback;
---

<Layout title={`お知らせ | ${site.name}`}>
	<Header />
	<main class="bg-cream pb-24 pt-[calc(var(--header-height,7rem)+1rem)] sm:pb-32 sm:pt-[calc(var(--header-height,9rem)+1.5rem)]">
		<div class="mx-auto max-w-4xl px-6 sm:px-8">
			<div class="js-reveal text-center">
				<p class="text-xs tracking-[0.35em] text-moss">NEWS</p>
				<h1 class="mt-3 font-serif text-2xl text-soil sm:text-3xl">お知らせ</h1>
				<div class="mx-auto mt-4 h-px w-16 bg-gold"></div>
			</div>

			<div class="js-reveal mt-12">
				<NewsList items={items} />
			</div>
		</div>
	</main>
	<Footer />
</Layout>
