---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
---

<Layout title={`お問い合わせありがとうございます | ${site.name}`}>
	<SiteHeader />
	<Header revealOnScroll={true} />
	<main class="bg-cream pb-24 pt-14 sm:pb-32 sm:pt-20">
		<div class="mx-auto max-w-2xl px-6 text-center sm:px-8">
			<p class="text-xs tracking-[0.35em] text-moss">THANK YOU</p>
			<h1 class="mt-3 font-serif text-2xl text-soil sm:text-3xl">送信が完了しました</h1>
			<div class="mx-auto mt-4 h-px w-16 bg-gold"></div>
			<p class="mt-6 text-sm leading-8 text-ink/80 sm:text-base sm:leading-9">
				お問い合わせいただきありがとうございます。<br />
				内容を確認のうえ、担当者より折り返しご連絡いたします。
			</p>
			<a
				href="/"
				class="mt-10 inline-flex items-center justify-center gap-2 rounded-full bg-gold px-8 py-3 text-sm font-medium tracking-wide text-cream shadow-md transition-colors hover:bg-gold-light"
			>
				トップページへ戻る
			</a>
		</div>
	</main>
	<Footer />
</Layout>
