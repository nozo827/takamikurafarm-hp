---
interface Props {
	label: string;
	tone?: 'moss' | 'soil' | 'gold';
	class?: string;
}

const { label, tone = 'moss', class: className = '' } = Astro.props;

const gradients: Record<string, string> = {
	moss: 'from-moss-light via-moss to-soil',
	soil: 'from-soil-light via-soil to-ink',
	gold: 'from-gold-light via-gold to-soil-light',
};

// 呼び出し側で position ユーティリティ (absolute など) を渡された場合は、
// こちらの既定 `relative` と衝突して意図しない方が勝つことがあるため付与しない。
const positionClass = /\b(absolute|fixed|sticky|static)\b/.test(className) ? '' : 'relative';
---

<div
	class={`${positionClass} overflow-hidden bg-gradient-to-br ${gradients[tone]} ${className}`}
>
	<svg
		class="absolute inset-0 h-full w-full opacity-20"
		xmlns="http://www.w3.org/2000/svg"
	>
		<pattern
			id={`dots-${label}`}
			width="22"
			height="22"
			patternUnits="userSpaceOnUse"
		>
			<circle cx="2" cy="2" r="1.4" fill="currentColor" class="text-cream"
			></circle>
		</pattern>
		<rect width="100%" height="100%" fill={`url(#dots-${label})`}></rect>
	</svg>
	<svg
		class="absolute inset-0 m-auto h-14 w-14 text-cream/30"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1"
	>
		<path
			d="M12 21c-4.5-2-8-6-8-11a8 8 0 0 1 16 0c0 5-3.5 9-8 11Z"
		></path>
		<path d="M12 21V8"></path>
	</svg>
	<span
		class="absolute bottom-3 left-3 rounded-full bg-ink/40 px-3 py-1 text-[11px] tracking-widest text-cream/90 backdrop-blur-sm"
	>
		{label}
	</span>
</div>
