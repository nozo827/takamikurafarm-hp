---
// 旧デザインのナビゲーション（Bootstrap の navbar）。
// PC 用・スマホ用・フッタの 3 箇所から呼ばれる。
import { mainNav } from '../../data/oldSite';

interface Props {
	/** Bootstrap の collapse が対象にする id。ページ内で重複しないよう呼び出し側が指定する。 */
	id: string;
}

const { id } = Astro.props;
---

<div class="navbar-collapse collapse justify-content-stretch" id={id}>
	<ul class="navbar-nav ml-auto fontb-b pb-1 border-top border-bottom">
		{
			mainNav.map((item) => (
				<li class="nav-item">
					<a class="nav-link" href={item.href}>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</div>
