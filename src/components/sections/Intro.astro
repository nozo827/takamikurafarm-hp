---
import { intro } from '../../data/site';
import ImagePlaceholder from '../ImagePlaceholder.astro';
---

<section class="relative z-10 flex h-[100svh] items-center justify-center overflow-hidden bg-ink">
	<ImagePlaceholder label="早朝の畑" tone="moss" class="absolute inset-0 h-full w-full" />
	<div class="absolute inset-0 bg-gradient-to-b from-ink/60 via-ink/45 to-ink/80"></div>

	<div class="js-reveal relative mx-auto max-w-3xl px-6 text-center sm:px-8">
		<p class="font-serif text-2xl leading-relaxed text-cream sm:text-3xl">
			{intro.catch}
		</p>
		<div class="mx-auto mt-8 h-px w-16 bg-gold"></div>
		<p class="mt-8 text-sm leading-8 text-cream/80 sm:text-base sm:leading-9">
			{intro.lines.map((line) => (
				<>
					{line}
					<br />
				</>
			))}
		</p>
		<p class="mx-auto mt-8 max-w-xl font-serif text-base leading-8 text-gold-light sm:text-lg">
			{intro.closing}
		</p>
	</div>
</section>
