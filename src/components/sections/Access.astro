---
import { access } from '../../data/site';
import ImagePlaceholder from '../ImagePlaceholder.astro';
---

<section id="access" class="bg-cream py-24 sm:py-32">
	<div class="mx-auto grid max-w-6xl gap-12 px-6 sm:px-8 lg:grid-cols-2 lg:items-center lg:gap-16">
		<div class="js-reveal">
			<p class="text-xs tracking-[0.35em] text-moss">ACCESS</p>
			<h2 class="mt-4 font-serif text-2xl text-soil sm:text-3xl">
				{access.title}
			</h2>
			<div class="mt-6 h-px w-16 bg-gold"></div>
			<p class="mt-8 text-sm leading-8 text-ink/80 sm:text-base sm:leading-9">
				{access.body}
			</p>
			<p class="mt-6 text-sm tracking-wide text-soil">
				{access.area}
			</p>
		</div>
		<ImagePlaceholder
			label="高御位山"
			tone="moss"
			class="js-reveal js-reveal-delay-1 aspect-[4/3] w-full rounded-sm"
		/>
	</div>
</section>
