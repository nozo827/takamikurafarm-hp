---
import { Image } from 'astro:assets';
import { hero } from '../../data/site';
import heroPhoto1 from '../../assets/photos/DSC07692.jpg';
import heroPhoto2 from '../../assets/photos/DSC07709.jpg';
import heroPhoto3 from '../../assets/photos/DSC07729.jpg';
import heroPhoto4 from '../../assets/photos/DSC07735.jpg';
import heroPhoto5 from '../../assets/photos/IMGP6676.jpg';
import heroPhoto6 from '../../assets/photos/IMGP6834.jpg';
import heroPhoto7 from '../../assets/photos/IMGP6888.jpg';

const heroPhotos = [
	heroPhoto1,
	heroPhoto2,
	heroPhoto3,
	heroPhoto4,
	heroPhoto5,
	heroPhoto6,
	heroPhoto7,
];
---

<section
	id="top"
	class="sticky top-0 z-0 flex h-[100svh] items-center overflow-hidden pb-[5.5rem] lg:pb-0"
>
	<div class="absolute inset-0 h-full w-full">
		{
			heroPhotos.map((photo, i) => (
				<Image
					src={photo}
					alt="高御位山の畑"
					width={1600}
					quality={70}
					loading={i === 0 ? 'eager' : 'lazy'}
					class={`hero-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-[1500ms] ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
				/>
			))
		}
	</div>
	<div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/55 to-ink/25"></div>

	<div class="hero-fade-in relative mx-auto w-full max-w-5xl px-6 pb-14 pt-14 text-center sm:px-8 sm:pb-24 sm:pt-24">
		<div class="space-y-0.5 text-cream/75">
			<p class="text-xs sm:text-sm">{hero.catchLead}</p>
			<p class="text-xs sm:text-sm">{hero.catchSub}</p>
		</div>
		<h1 class="mt-3 font-serif text-lg leading-relaxed text-cream/95 sm:mt-5 sm:text-2xl">
			{hero.catchMain}
		</h1>
		<p class="mt-2 font-serif text-sm text-gold-light/90 sm:mt-3 sm:text-base">
			—— {hero.catchTail}
		</p>
		<p class="mx-auto mt-5 max-w-xl text-xs leading-7 text-cream/65 sm:mt-8 sm:text-sm sm:leading-8">
			{hero.lead}
		</p>
	</div>
</section>

<script>
	const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
	if (slides.length > 1) {
		let current = 0;
		setInterval(() => {
			slides[current].classList.remove('opacity-100');
			slides[current].classList.add('opacity-0');
			current = (current + 1) % slides.length;
			slides[current].classList.remove('opacity-0');
			slides[current].classList.add('opacity-100');
		}, 5000);
	}
</script>
