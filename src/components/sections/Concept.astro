---
import { Image } from 'astro:assets';
import { hero, site } from '../../data/site';
import conceptPhoto1 from '../../assets/photos/20260809_083316_IMGP6847.JPG';
import conceptPhoto2 from '../../assets/photos/20260809_060502_IMGP6696.JPG';

const conceptPhotos = [conceptPhoto1, conceptPhoto2];
---

<section id="concept" class="bg-soil py-16 text-cream sm:py-20">
	<div class="mx-auto grid max-w-5xl gap-8 px-6 sm:px-8 lg:grid-cols-2 lg:items-center lg:gap-12">
		<div class="js-reveal">
			<p class="text-xs tracking-[0.35em] text-gold-light">CONCEPT</p>
			<h2 class="mt-3 font-serif text-2xl text-cream sm:text-3xl">
				{site.brandJa}
			</h2>
			<div class="mt-3 h-px w-16 bg-gold"></div>
			<p class="mt-6 text-sm leading-8 text-cream/85 sm:text-base sm:leading-9">
				{hero.lead}
			</p>
		</div>
		<div
			class="js-reveal js-reveal-delay-1 relative mx-auto aspect-[4/3] w-full max-w-sm overflow-hidden rounded-sm"
		>
			{
				conceptPhotos.map((photo, i) => (
					<Image
						src={photo}
						alt="収穫の様子"
						class={`concept-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-[1500ms] ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
					/>
				))
			}
		</div>
	</div>
</section>

<script>
	// 5 秒ごとに写真を切り替える。ヒーロー(Hero.astro)と同じ作り。
	const slides = document.querySelectorAll<HTMLElement>('.concept-slide');
	if (slides.length > 1) {
		let current = 0;
		setInterval(() => {
			slides[current].classList.remove('opacity-100');
			slides[current].classList.add('opacity-0');
			current = (current + 1) % slides.length;
			slides[current].classList.remove('opacity-0');
			slides[current].classList.add('opacity-100');
		}, 5000);
	}
</script>
